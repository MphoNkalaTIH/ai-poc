
```ini
[Unit]
Description=Numina Solderless Educational Assistant Core Lifecycle Engine
After=multi-user.target sound.target display-manager.target
Wants=sound.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/numina
Environment=PYTHONUNBUFFERED=1
# Run the current GUI app with the virtual environment containing its Python dependencies.
ExecStart=/home/pi/numina-venv/bin/python /home/pi/numina/numina.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target